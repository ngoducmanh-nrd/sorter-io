{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sorter.io",
  "version": "2.2.0",
  "identifier": "com.sorterio.app",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npx serve src -l 1420 --no-clipboard",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sorter.io - Auto File Organizer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--enable-features=FileSystemAccessAPI,msWebView2EnableDraggableRegions"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NzY4M0M3NTdDMjRBRApSV1N0Skh4MVBHaG5BNmJXRVdFWXRrQVAydEJVUnAvZDU3eksxRlNXMStXVTdCT0ZhWERyZ3R4SQo=",
      "endpoints": [
        "https://github.com/ngoducmanh-nrd/sorter-io/releases/latest/download/latest.json"
      ]
    }
  }
}
